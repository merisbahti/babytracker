{:source-paths ["src/main"]
 :dependencies [[reagent "1.2.0"]
                [re-frame "1.3.0"]
                [metosin/malli "0.14.0"]]
 :dev-http {3000 "public"}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn babytracker.core/init}}
                :devtools {:after-load babytracker.core/mount
                          :preloads [user]}
                :release {:output-dir "docs/assets"
                          :asset-path "/babytracker/assets"}}}}
